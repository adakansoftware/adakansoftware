{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adakansoftware",
  "main": ".free-worker/worker.js",
  "triggers": { "crons": ["0 * * * *"] },
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "build": {
    "command": "npm run build:cloudflare"
  },
  "assets": {
    "directory": ".free-worker/assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "observability": { "enabled": true },
  // Cloudflare Web Analytics beacon token. Set a real token (dashboard > Web Analytics)
  // to enable the cookieless beacon; empty keeps the site tracking-free.
  "vars": { "CF_ANALYTICS_TOKEN": "" }
}
