{
  "name": "adakan-software-website",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test --test-isolation=none \"lib/**/*.test.mjs\"",
    "test:secrets": "node scripts/check-secrets.mjs && node --test scripts/check-secrets.test.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "db:apply-schema": "node --env-file=.env.local scripts/apply-neon-schema.mjs",
    "test:admin-security": "node --experimental-strip-types --test lib/admin-contact.test.mjs lib/admin-content.test.mjs lib/admin-content-request.test.mjs lib/admin-login-config.test.mjs lib/admin-session.test.mjs lib/admin-session-request.test.mjs lib/contact-request-store.test.mjs lib/content-source-status.test.mjs lib/server/admin-login-rate-limit.test.mjs lib/server/contact-state-store-status.test.mjs lib/server/secret-policy.test.mjs",
    "test:seo": "node --experimental-strip-types --test --test-isolation=none lib/public-routes.test.mjs lib/structured-data.test.mjs lib/seo-routes.test.mjs",
    "test:smoke": "node scripts/run-smoke-routes.mjs",
    "test:smoke:boundaries": "node scripts/run-smoke-routes.mjs ./test-request-boundaries.mjs",
    "test:smoke:production": "node scripts/run-smoke-routes.mjs ./test-security-headers.mjs --production",
    "ops:contact:worker": "node scripts/contact-replay-worker.mjs",
    "build:cloudflare": "opennextjs-cloudflare build",
    "deploy": "wrangler deploy",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@neondatabase/serverless": "^1.1.0",
    "@radix-ui/react-accordion": "1.2.20",
    "@radix-ui/react-alert-dialog": "1.1.23",
    "@radix-ui/react-aspect-ratio": "1.1.15",
    "@radix-ui/react-avatar": "1.2.6",
    "@radix-ui/react-checkbox": "1.3.11",
    "@radix-ui/react-collapsible": "1.1.20",
    "@radix-ui/react-context-menu": "2.3.7",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-hover-card": "1.1.23",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-menubar": "1.1.24",
    "@radix-ui/react-navigation-menu": "1.2.22",
    "@radix-ui/react-popover": "1.1.23",
    "@radix-ui/react-progress": "1.1.16",
    "@radix-ui/react-radio-group": "1.4.7",
    "@radix-ui/react-scroll-area": "1.2.18",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slider": "1.4.7",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-switch": "1.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/react-toggle": "1.1.18",
    "@radix-ui/react-toggle-group": "1.1.19",
    "@radix-ui/react-tooltip": "1.2.16",
    "autoprefixer": "^10.6.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.3",
    "lucide-react": "^1.48.0",
    "next": "^16.3.0",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7.88.0",
    "redis": "^6.2.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.3.6",
    "@opennextjs/cloudflare": "1.20.6",
    "@tailwindcss/postcss": "^4.2.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10.3.0",
    "postcss": "^8.5",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.2.0",
    "tw-animate-css": "1.3.3",
    "typescript": "5.7.3",
    "typescript-eslint": "^8.59.2",
    "wrangler": "4.136.3"
  }
}
